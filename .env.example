# Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# Google Apps Script Web App URL
# Get this from Google Apps Script deployment
VITE_APPSCRIPT_URL=https://script.google.com/macros/d/YOUR_SCRIPT_ID/usercurrent/exec

# Google Sheet ID
# The ID from your Google Sheet URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
VITE_SHEET_ID=YOUR_SHEET_ID

# API Base URL (if using a custom backend)
# VITE_API_URL=https://api.example.com

# Authentication
# For development/testing
VITE_AUTH_ENABLED=true

# Feature Flags
VITE_ENABLE_EXPORT=true
VITE_ENABLE_IMPORT=true
