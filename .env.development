# Development Environment Variables
# Used when running: npm run dev

# Local Google Apps Script URL (typically ends with /dev/exec for testing)
VITE_APPSCRIPT_URL=https://script.google.com/macros/d/YOUR_DEV_SCRIPT_ID/usercurrent/exec

# Your development Google Sheet ID
VITE_SHEET_ID=YOUR_DEV_SHEET_ID

# Enable detailed logging for debugging
VITE_DEBUG=true

# Feature toggles for development
VITE_ENABLE_EXPORT=true
VITE_ENABLE_IMPORT=true

# Disable strict SSL for local development (if needed)
NODE_TLS_REJECT_UNAUTHORIZED=0
